[t:template,n:skill_runes_container_{{level}}]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes Level {{level}}";
    [inventory]
    {
        [other]
        {
            {% for skill in skills %}
            il_main = skill_rune_{{skill.skill}}_{{level}};
            {% endfor %}
        }
    }
}
