{% set skill_names = {s.skill: s.skill_name for s in skillz} %}
{% set skill_name = skill_names[skills] %}
{% set is_multiclass = '+' in skills %}
[t:template,n:3W_skill_rune_{{skills | replace('+', '_')}}_{{level}}]
{
	specializes = base_skill_rune_{{skills if not is_multiclass else 'multi'}};

	common:screen_name = "{{skill_name}} {% if is_multiclass %}Uber {% endif %}Level {{uber | int}} (Regular {{level}})";
	[skill_rune]
	{
		uber_stat	= {{'%0.2f' % uber}};
		melee_stat	= {{'%0.2f' % melee}};
		ranged_stat	= {{'%0.2f' % ranged}};
		nmagic_stat	= {{'%0.2f' % nmagic}};
		cmagic_stat	= {{'%0.2f' % cmagic}};
		str_stat	= {{'%0.2f' % strength}};
		dex_stat	= {{'%0.2f' % dexterity}};
		int_stat	= {{'%0.2f' % intelligence}};
	}
}
