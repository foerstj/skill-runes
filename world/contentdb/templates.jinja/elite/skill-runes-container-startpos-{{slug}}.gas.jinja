[t:template,n:3W_skill_runes_container_startpos_{{slug}}]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes Elite {{startpos}}";
    [inventory]
    {
        [other]
        {
            {% for skill in skills %}
            il_main = 3W_skill_rune_{{skill.skill}}_startpos_{{slug}};
            {% endfor %}
        }
    }
}
