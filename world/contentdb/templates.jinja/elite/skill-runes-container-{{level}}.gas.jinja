[t:template,n:3W_skill_runes_container_{{level}}]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes Level {{uber | int}} (Regular {{level}})";
    [inventory]
    {
        [other]
        {
            {% for skill in skills %}
            il_main = 3W_skill_rune_{{skill.skill}}_{{level}};
            {% endfor %}
        }
    }
}
