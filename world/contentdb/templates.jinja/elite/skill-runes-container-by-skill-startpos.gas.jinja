{% for skill in skills %}
[t:template,n:3W_skill_runes_container_{{ skill.skill | replace('+', '_') }}_startpos]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes - {{ skill.skill_name }} - Elite Start Positions";
    [inventory]
    {
        [other]
        {
			{% for row in data if row.skills == skill.skill %}
            il_main = 3W_skill_rune_{{ skill.skill | replace('+', '_') }}_startpos_{{ row.slug }};
            {% endfor %}
        }
    }
}
{% endfor %}
