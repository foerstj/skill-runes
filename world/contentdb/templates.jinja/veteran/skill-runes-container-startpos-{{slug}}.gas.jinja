[t:template,n:2W_skill_runes_container_startpos_{{slug}}]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes Veteran {{startpos}}";
    [inventory]
    {
        [other]
        {
            {% for skill in skills %}
            il_main = 2W_skill_rune_{{skill.skill | replace('+', '_')}}_startpos_{{slug}};
            {% endfor %}
        }
    }
}
