{% for skill in skills %}
[t:template,n:2W_skill_runes_container_{{ skill.skill | replace('+', '_') }}]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Veteran Skill Runes - {{ skill.skill_name }}";
    [inventory]
    {
        [other]
        {
            {% for row in data if row.skills == skill.skill %}
            il_main = 2W_skill_rune_{{ skill.skill | replace('+', '_') }}_{{ row.level }};
            {% endfor %}
        }
    }
}
{% endfor %}
