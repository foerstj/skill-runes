{% for skill, skill_name in {'melee': 'Melee', 'ranged': 'Ranged', 'nmagic': 'Nature Magic', 'cmagic': 'Combat Magic'}.items() %}
[t:template,n:2W_skill_runes_container_{{ skill }}_startpos]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes - {{ skill_name }} - Veteran Start Positions";
    [inventory]
    {
        [other]
        {
			{% for row in data if row.skills == skill %}
            il_main = 2W_skill_rune_{{ skill }}_startpos_{{ row.slug }};
            {% endfor %}
        }
    }
}
{% endfor %}
