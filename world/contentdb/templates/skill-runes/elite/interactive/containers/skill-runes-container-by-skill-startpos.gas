[t:template,n:3W_skill_runes_container_melee_startpos]
{
    specializes = base_skill_runes_container;

    common:screen_name = "Skill Runes - Melee - Elite Start Positions";
    [inventory]
    {
        [other]
        {
            il_main = 3W_skill_rune_melee_startpos_elddim;
            il_main = 3W_skill_rune_melee_startpos_crystwind;
            il_main = 3W_skill_rune_melee_startpos_fallraen;
            il_main = 3W_skill_rune_melee_startpos_meren;
            il_main = 3W_skill_rune_melee_startpos_lang;
            il_main = 3W_skill_rune_melee_startpos_quillrabe;
            il_main = 3W_skill_rune_melee_startpos_hiroth;
            il_main = 3W_skill_rune_melee_startpos_grescal;
            il_main = 3W_skill_rune_melee_startpos_arhok;
            il_main = 3W_skill_rune_melee_startpos_illicor;
            il_main = 3W_skill_rune_melee_startpos_tradercamp;
            il_main = 3W_skill_rune_melee_startpos_demlockscut;
            il_main = 3W_skill_rune_melee_startpos_neenersemporium;
