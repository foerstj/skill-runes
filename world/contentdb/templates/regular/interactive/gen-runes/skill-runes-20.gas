// skill runes lvl 20

[t:template,n:skill_rune_melee_20]
{
	specializes = base_skill_rune_melee;

	common:screen_name = "Melee Level 20";
	[skill_rune]
	{
		uber_stat	= 20.00;
		melee_stat	= 20.00;
		ranged_stat	= 0.00;
		nmagic_stat	= 0.00;
		cmagic_stat	= 0.00;
		str_stat	= 12.80;
		dex_stat	= 5.40;
		int_stat	= 1.80;
	}
}

