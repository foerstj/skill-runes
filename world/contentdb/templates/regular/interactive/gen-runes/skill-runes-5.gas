// skill runes lvl 5

[t:template,n:skill_rune_melee_5]
{
	specializes = base_skill_rune_melee;

	common:screen_name = "Melee Level 5";
	[skill_rune]
	{
		uber_stat	= 5;
		melee_stat	= 5;
		ranged_stat	= 0;
		nmagic_stat	= 0;
		cmagic_stat	= 0;
		str_stat	= 3.20;
		dex_stat	= 1.35;
		int_stat	= 0.45;
	}
}

