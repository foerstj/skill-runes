// skill runes lvl 100

[t:template,n:skill_rune_melee_100]
{
	specializes = base_skill_rune_melee;

	common:screen_name = "Melee Level 100";
	[skill_rune]
	{
		uber_stat	= 100;
		melee_stat	= 100;
		ranged_stat	= 0;
		cmagic_stat	= 0;
		nmagic_stat	= 0;
		int_stat	= 9.00;
		dex_stat	= 27.00;
		str_stat	= 64.00;
	}
}

