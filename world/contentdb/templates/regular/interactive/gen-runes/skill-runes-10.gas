// skill runes lvl 10

[t:template,n:skill_rune_melee_10]
{
	specializes = base_skill_rune_melee;

	common:screen_name = "Melee Level 10";
	[skill_rune]
	{
		uber_stat	= 10.00;
		melee_stat	= 10.00;
		ranged_stat	= 0.00;
		nmagic_stat	= 0.00;
		cmagic_stat	= 0.00;
		str_stat	= 6.40;
		dex_stat	= 2.70;
		int_stat	= 0.90;
	}
}

