// skill runes lvl 80

[t:template,n:skill_rune_melee_80]
{
	specializes = base_skill_rune_melee;

	common:screen_name = "Melee Level 80";
	[skill_rune]
	{
		uber_stat	= 80;
		melee_stat	= 80;
		ranged_stat	= 0;
		cmagic_stat	= 0;
		nmagic_stat	= 0;
		int_stat	= 7.20;
		dex_stat	= 21.60;
		str_stat	= 51.20;
	}
}

